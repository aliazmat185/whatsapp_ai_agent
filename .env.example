APP_NAME="AI Sales Agent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_sales_agent
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — PLATFORM-LEVEL credentials, used for ALL vendors.
# See PLAN.md decision-8 / A11 / §5a.
# ---------------------------------------------------------------------------
WHATSAPP_WABA_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
# Override only if you proxy/mock the Graph API; leave unset in normal dev.
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_DEV_PHONE_NUMBER_ID=
WHATSAPP_TWO_STEP_PIN=
WHATSAPP_CATALOG_ID=
# Multi-select product picker Flow — set after running
# `php artisan whatsapp:flow:generate-keys` and `whatsapp:flow:register`.
WHATSAPP_FLOW_ID=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
# Meta must be able to fetch product images over the public internet. Point
# this at an ngrok/Cloudflare Tunnel URL when APP_URL is localhost; leave
# unset in production, where APP_URL is already public.
PUBLIC_ASSET_BASE_URL=

# ---------------------------------------------------------------------------
# AI provider selection — which LlmClient/EmbeddingProviderContract the app
# talks to. Chat provider and embedding provider are chosen independently.
# provider: anthropic | huggingface | openrouter | gemini
# embedding_provider: openai | gemini
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai
# Cosine-similarity floor for a "real" knowledge-base/product match. Tuned
# per embedding model — 0.7 for OpenAI's text-embedding-3-small, 0.6 for
# Gemini's gemini-embedding-001. Leave unset to use that default.
EMBEDDING_SCORE_THRESHOLD=

# ---------------------------------------------------------------------------
# Claude / Anthropic — default AI agent + tool-use loop
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOOL_ITERATIONS=5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# OpenAI — embeddings by default (Claude has no embedding API), and usable
# as a chat provider only via the OpenAI-compatible client if configured.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# OpenRouter — optional alternative chat provider (AI_PROVIDER=openrouter)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Comma-separated auto-failover list, tried in order if the primary model
# above is rate-limited/unavailable.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-nano-9b-v2:free

# ---------------------------------------------------------------------------
# Gemini — optional alternative chat provider AND/OR embedding provider
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

# ---------------------------------------------------------------------------
# Hugging Face — optional alternative chat provider (AI_PROVIDER=huggingface)
# ---------------------------------------------------------------------------
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_BASE_URL=https://router.huggingface.co

# ---------------------------------------------------------------------------
# Qdrant — vector store for RAG knowledge base + product semantic search.
# Single collection, every point/query scoped by vendor_id payload filter.
# `docker compose up -d qdrant` starts this locally.
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_VECTOR_SIZE=1536

# ---------------------------------------------------------------------------
# Commerce defaults
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=PKR
STORE_SEARCH_RADIUS_KM=50
DEFAULT_LOW_STOCK_THRESHOLD=5
# Flat delivery fee applied when a store is confirmed to deliver to the
# customer's city. 0 = free delivery by default.
DEFAULT_DELIVERY_FEE=0

# ---------------------------------------------------------------------------
# Payment gateways (stub in v1 — real creds added when integrating)
# ---------------------------------------------------------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=
