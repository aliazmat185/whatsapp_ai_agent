APP_NAME="AI Sales Agent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_sales_agent
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — PLATFORM-LEVEL credentials, used for ALL vendors.
# See PLAN.md decision-8 / A11 / §5a.
# ---------------------------------------------------------------------------
WHATSAPP_WABA_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEV_PHONE_NUMBER_ID=
WHATSAPP_TWO_STEP_PIN=
WHATSAPP_CATALOG_ID=

# ---------------------------------------------------------------------------
# Claude / Anthropic — AI agent
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOOL_ITERATIONS=5

# ---------------------------------------------------------------------------
# OpenAI — embeddings only (Claude has no embedding API). See RAG_PLAN.md.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Qdrant — vector store for RAG knowledge base + product semantic search.
# Single collection, every point/query scoped by vendor_id payload filter.
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_VECTOR_SIZE=1536

# ---------------------------------------------------------------------------
# Commerce defaults
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=PKR
STORE_SEARCH_RADIUS_KM=50
DEFAULT_LOW_STOCK_THRESHOLD=5

# ---------------------------------------------------------------------------
# Payment gateways (stub in v1 — real creds added when integrating)
# ---------------------------------------------------------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=
